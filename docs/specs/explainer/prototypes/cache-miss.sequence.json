      "label": "订单接口",
      "sublabel": "API"
    },
    {
      "id": "redis",
      "type": "database",
      "label": "Redis",
      "sublabel": "缓存"
    },
    {
      "id": "postgres",
      "type": "database",
      "label": "PostgreSQL",

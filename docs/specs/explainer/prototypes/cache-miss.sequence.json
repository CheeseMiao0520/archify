      "label": "SELECT … WHERE id = 42",
      "variant": "emphasis"
    },
    {
      "id": "db-rows",
      "from": "postgres",
      "to": "api",
      "y": 430,
      "label": "结果行",
      "variant": "return"
    },
    {
      "id": "cache-set",
      "from": "api",
      "to": "redis",
      "y": 495,
      "label": "SET order:42 EX 300 · 写回",
      "variant": "emphasis"
    },
    {
      "id": "resp",
      "from": "api",
